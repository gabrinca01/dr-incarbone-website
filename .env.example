# ── Preview protection (HTTP Basic Auth) ──────────────────────────────────────
# Copy this file to .env.local for local testing:
#   cp .env.example .env.local
#
# Protection is handled by proxy.ts at the project root.
# On Vercel: set these variables in the Preview environment only.
# Leave Production without BASIC_AUTH_ENABLED so the live site stays public.

# Enable auth locally (Vercel Preview enables automatically via VERCEL_ENV)
BASIC_AUTH_ENABLED=true

BASIC_AUTH_USER=preview
BASIC_AUTH_PASSWORD=your-secure-password-here
